# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend y base de datos local. No suba valores reales al repositorio.
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
DATABASE_URL="postgresql://formularios:CAMBIE_ESTA_CLAVE@localhost:5432/formularios"
POSTGRES_PASSWORD="CAMBIE_ESTA_CLAVE"
# Genere un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET="REEMPLACE_POR_UN_SECRETO_LARGO_Y_ALEATORIO_DE_32_CARACTERES"

# Este usuario se crea solo una vez al inicializar una base vacía.
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@ejemplo.gob.gt"
ADMIN_PASSWORD="CAMBIE_ESTA_CLAVE"
ADMIN_DEPARTMENT="Administración"

# Correo saliente (avisos de respuestas y reportes programados). Opcional.
# SMTP_HOST=console imprime los correos en el log del API en lugar de enviarlos (pruebas).
# SMTP_HOST="smtp.ejemplo.gob.gt"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Formularios <formularios@ejemplo.gob.gt>"

# Sesión y seguridad. La sesión viaja en una cookie HttpOnly.
# Si el frontend y la API están en sitios (dominios) distintos use COOKIE_SAMESITE="None" (exige HTTPS).
# COOKIE_SAMESITE="Lax"
# COOKIE_SECURE=true          # por defecto true cuando NODE_ENV=production
# TRUST_PROXY=1               # número de proxies delante de la API (para limitar intentos por IP real)

# Variable pública que usa el frontend para llamar a la API.
VITE_API_URL="http://localhost:4000"
